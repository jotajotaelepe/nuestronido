{%- comment -%}
  Nuestro Nido brand pillars (Figma Home "Pilares de marca", node 9772:2443):
  mantequilla band, isotipo, centered title + intro, 4 numbered pillars with line illustrations.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
-%}
<section class="nn-pillars nn-section-spacing" style="--nn-pillars-bg: {{ s.background }};">
  <div class="nn-wrap">
    <div class="nn-pillars__intro">
      {%- if s.show_isotipo -%}
        {%- render 'nn-logo', variant: 'isotipo', class: 'nn-pillars__isotipo' -%}
      {%- endif -%}
      <h2 class="nn-pillars__title">{{ s.heading }}</h2>
      {%- if s.text != blank -%}<p class="nn-pillars__text">{{ s.text }}</p>{%- endif -%}
    </div>
    <ol class="nn-pillars__list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="nn-pillar" {{ block.shopify_attributes }}>
          <div class="nn-pillar__art">
            {%- if b.image != blank -%}
              {{ b.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: '' }}
            {%- else -%}
              {%- render 'nn-pillar-art', icon: b.icon -%}
            {%- endif -%}
          </div>
          <span class="nn-pillar__number" aria-hidden="true">{{ forloop.index }}</span>
          <h3 class="nn-pillar__title nn-badge">{{ b.title }}</h3>
          <div class="nn-pillar__text">{{ b.text }}</div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% stylesheet %}
  .nn-pillars { background: var(--nn-pillars-bg, var(--nn-color-mantequilla)); color: var(--nn-color-tinta); }
  .nn-pillars__intro { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 12px; margin-block-end: var(--nn-space-6); }
  .nn-pillars__isotipo { width: 146px; height: auto; color: var(--nn-color-taupe); margin-block-end: 20px; }
  .nn-pillars__title { margin: 0; font-size: var(--font-size--h1); font-weight: 400; line-height: 1.05; letter-spacing: -0.06em; color: var(--nn-color-taupe); }
  .nn-pillars__text { margin: 0; font-size: 14px; max-width: 60ch; }
  .nn-pillars__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 48px; }
  .nn-pillar { display: flex; flex-direction: column; align-items: flex-start; gap: 0; }
  .nn-pillar__art { width: 128px; height: 116px; color: var(--nn-color-taupe); margin-block-end: 16px; }
  .nn-pillar__art img, .nn-pillar__art svg { width: 100%; height: 100%; object-fit: contain; object-position: left bottom; }
  .nn-pillar__number { display: inline-grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; border: 1px solid currentColor; font-size: 11px; margin-block-end: 16px; }
  .nn-pillar__title { margin: 0 0 8px; }
  .nn-pillar__text, .nn-pillar__text p { margin: 0; font-size: 14px; line-height: 1.5; color: color-mix(in srgb, var(--nn-color-tinta) 75%, transparent); }
  @media screen and (max-width: 989px) { .nn-pillars__list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 24px; } }
  @media screen and (max-width: 480px) { .nn-pillars__list { grid-template-columns: 1fr; } }
{% endstylesheet %}

{% schema %}
{
  "name": "NN · Pilares de marca",
  "tag": "div",
  "settings": [
    { "type": "color", "id": "background", "label": "Fondo", "default": "#F3EFA8" },
    { "type": "checkbox", "id": "show_isotipo", "label": "Mostrar isotipo", "default": true },
    { "type": "text", "id": "heading", "label": "Título", "default": "Amueblar tu casa es sencillo." },
    { "type": "text", "id": "text", "label": "Texto", "default": "Muebles de diseño para espacios reales, con medidas exactas, precio claro y entrega en 72 horas." }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pilar",
      "settings": [
        { "type": "select", "id": "icon", "label": "Ilustración", "default": "medidas", "options": [
          { "value": "medidas", "label": "Medidas" }, { "value": "precio", "label": "Precio" },
          { "value": "entrega", "label": "Entrega" }, { "value": "transporte", "label": "Transporte" }
        ] },
        { "type": "image_picker", "id": "image", "label": "Ilustración propia (opcional)" },
        { "type": "text", "id": "title", "label": "Título", "default": "Medidas exactas" },
        { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Cada pieza indica sus dimensiones reales.</p>" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "NN · Pilares de marca" }]
}
{% endschema %}
