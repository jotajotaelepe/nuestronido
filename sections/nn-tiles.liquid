{%- comment -%}
  Nuestro Nido tile row (Figma Home "Explora por espacio" and "Explora por producto"):
  title + subtitle, then up to 5 portrait tiles with a label under each.
  Tile image: picked image → linked collection's image → provisional asset → placeholder.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
-%}
<section class="nn-tiles" style="padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px;">
  <div class="nn-wrap">
    <header class="nn-section-head">
      <h2 class="nn-section-head__title">{{ s.heading }}</h2>
      {%- if s.text != blank -%}<p class="nn-section-head__text">{{ s.text }}</p>{%- endif -%}
    </header>
    <ul class="nn-tiles__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign nn_href = b.link | default: b.collection.url | default: '#'
          assign nn_img = b.image | default: b.collection.featured_image
        -%}
        <li class="nn-tile" {{ block.shopify_attributes }}>
          <a href="{{ nn_href }}" class="nn-tile__link">
            <div class="nn-tile__media">
              {%- if nn_img != blank -%}
                {{ nn_img | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 20vw, 45vw', widths: '300, 500, 800', alt: b.label }}
              {%- elsif b.fallback_asset != blank -%}
                <img src="{{ b.fallback_asset | asset_url }}" alt="{{ b.label | escape }}" loading="lazy">
              {%- endif -%}
            </div>
            <span class="nn-tile__label">{{ b.label | default: b.collection.title }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .nn-tiles__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 32px; }
  .nn-tile__link { display: flex; flex-direction: column; gap: 16px; color: inherit; text-decoration: none; }
  .nn-tile__media { position: relative; aspect-ratio: 245 / 330; overflow: hidden; border-radius: 4px; background: var(--nn-color-placeholder); }
  .nn-tile__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .nn-tile__link:hover .nn-tile__media img { transform: scale(1.03); }
  .nn-tile__label { font-size: var(--font-size--h3); line-height: 1.15; letter-spacing: -0.04em; color: var(--nn-color-taupe); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .nn-tile__link:hover .nn-tile__label { color: var(--nn-color-tinta); }
  @media screen and (max-width: 989px) {
    .nn-tiles__grid { grid-auto-flow: column; grid-template-columns: none; grid-auto-columns: 42%; overflow-x: auto; scroll-snap-type: x mandatory; gap: 16px; padding-block-end: 8px; scrollbar-width: none; }
    .nn-tile { scroll-snap-align: start; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "NN · Mosaico",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Explora por espacio" },
    { "type": "text", "id": "text", "label": "Subtítulo", "default": "Comienza por el cuarto que quieres amueblar." },
    { "type": "range", "id": "padding_top", "label": "Espacio arriba", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio abajo", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Mosaico",
      "settings": [
        { "type": "text", "id": "label", "label": "Etiqueta" },
        { "type": "collection", "id": "collection", "label": "Colección" },
        { "type": "url", "id": "link", "label": "Enlace (si no es la colección)" },
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "fallback_asset", "label": "Imagen provisional (archivo en assets)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "NN · Mosaico" }]
}
{% endschema %}
