{%- comment -%}
  Nuestro Nido footer (Figma "Footer / Desktop", node 9763:210).
  Taupe background, big isotipo, newsletter, up to 6 link/contact columns and a legal row.

  Mobile rules (from the build plan): newsletter first, link columns become accordions,
  payment methods last.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign social_names = 'Instagram,Facebook,TikTok,Pinterest,YouTube' | split: ','
  assign social_keys = 'instagram,facebook,tiktok,pinterest,youtube' | split: ','
-%}

<footer
  class="nn-footer"
  style="--nn-footer-bg: {{ s.background_color }}; --nn-footer-fg: {{ s.text_color }};"
  data-nn-footer
>
  <div class="nn-footer__inner">
    <div class="nn-footer__top">
      {%- if s.show_isotipo -%}
        <a href="{{ routes.root_url }}" class="nn-footer__isotipo-link">
          {%- render 'nn-logo', variant: 'isotipo', class: 'nn-footer__isotipo' -%}
        </a>
      {%- endif -%}

      <div class="nn-footer__newsletter">
        {%- if s.newsletter_heading != blank -%}
          <h2 class="nn-footer__newsletter-heading">{{ s.newsletter_heading }}</h2>
        {%- endif -%}
        {%- if s.newsletter_text != blank -%}
          <p class="nn-footer__newsletter-text">{{ s.newsletter_text }}</p>
        {%- endif -%}

        {%- form 'customer', id: 'NNFooterNewsletter', class: 'nn-footer__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label for="NNFooterEmail-{{ section.id }}" class="visually-hidden">
            Correo electrónico
          </label>
          <div class="nn-footer__field">
            <input
              id="NNFooterEmail-{{ section.id }}"
              type="email"
              name="contact[email]"
              class="nn-footer__input"
              placeholder="{{ s.newsletter_placeholder | escape }}"
              autocomplete="email"
              autocapitalize="off"
              spellcheck="false"
              required
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="NNFooterNewsletterError-{{ section.id }}"
              {% endif %}
            >
            <button type="submit" class="nn-footer__submit" aria-label="{{ s.newsletter_button_label | escape }}">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                <path d="M3 8H13M9 12L13 8L9 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
          {%- if form.errors -%}
            <p id="NNFooterNewsletterError-{{ section.id }}" class="nn-footer__form-message" role="alert">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </p>
          {%- elsif form.posted_successfully? -%}
            <p class="nn-footer__form-message" role="status">{{ s.newsletter_success }}</p>
          {%- endif -%}
        {%- endform -%}

        {%- capture social_links -%}
          {%- for key in social_keys -%}
            {%- assign setting_id = 'social_' | append: key -%}
            {%- if s[setting_id] != blank -%}
              <li><a href="{{ s[setting_id] }}" target="_blank" rel="noopener">{{ social_names[forloop.index0] }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if social_links != blank -%}
          <ul class="nn-footer__social list-unstyled">{{ social_links }}</ul>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="nn-footer__columns">
        {%- for block in section.blocks -%}
          <details class="nn-footer__column" open {{ block.shopify_attributes }}>
            <summary class="nn-footer__column-heading">
              <span>{{ block.settings.heading }}</span>
              <svg class="nn-footer__chevron" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
                <path d="M3.5 5.25L7 8.75L10.5 5.25" stroke="currentColor" stroke-width="1.225" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>
            <div class="nn-footer__column-body">
              {%- case block.type -%}
                {%- when 'menu' -%}
                  {%- if block.settings.menu != blank -%}
                    <ul class="list-unstyled">
                      {%- for link in block.settings.menu.links -%}
                        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                {%- when 'text' -%}
                  <div class="nn-footer__rte">{{ block.settings.text }}</div>
              {%- endcase -%}
            </div>
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="nn-footer__legal">
      <ul class="nn-footer__legal-links list-unstyled">
        <li>&copy; {{ 'now' | date: '%Y' }} {{ s.copyright_text | default: shop.name }}</li>
        {%- if s.show_policies -%}
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}
              <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if s.legal_menu != blank -%}
          {%- for link in s.legal_menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
      {%- if s.payment_text != blank -%}
        <p class="nn-footer__payments">{{ s.payment_text }}</p>
      {%- endif -%}
    </div>
  </div>
</footer>

<script>
  (() => {
    // Columns are open on desktop and collapse into accordions under 750px.
    const mq = window.matchMedia('(max-width: 749px)');
    const sync = () => {
      document.querySelectorAll('[data-nn-footer] .nn-footer__column').forEach((el) => {
        el.open = !mq.matches;
      });
    };
    sync();
    mq.addEventListener('change', sync);
  })();
</script>

{% schema %}
{
  "name": "Nuestro Nido footer",
  "tag": "section",
  "class": "nn-footer-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#938067"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "show_isotipo",
      "label": "Show brand mark",
      "default": true
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "Recibe ideas para tu espacio"
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Text",
      "default": "Guías de medidas, lanzamientos y promos. Un correo al mes."
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Placeholder",
      "default": "tu@correo.com"
    },
    {
      "type": "text",
      "id": "newsletter_button_label",
      "label": "Button label (screen readers)",
      "default": "Suscribirme"
    },
    {
      "type": "text",
      "id": "newsletter_success",
      "label": "Success message",
      "default": "¡Listo! Ya estás suscrito."
    },
    {
      "type": "header",
      "content": "Social"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok"
    },
    {
      "type": "url",
      "id": "social_pinterest",
      "label": "Pinterest"
    },
    {
      "type": "url",
      "id": "social_youtube",
      "label": "YouTube"
    },
    {
      "type": "header",
      "content": "Legal row"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright name",
      "default": "Nuestro Nido"
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Show store policies",
      "default": true
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Extra legal links"
    },
    {
      "type": "text",
      "id": "payment_text",
      "label": "Payment methods",
      "default": "Métodos de pago:  Visa · MC · Amex · PayPal · OXXO · MSI"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Explora por espacio"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Contacto"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>WhatsApp · 55 0000 0000</p><p>Teléfono · 55 0000 0000</p><p>hola@nuestronido.mx</p><p>Lun–Vie 9:00–18:00</p>"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  },
  "presets": [
    {
      "name": "Nuestro Nido footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Explora por espacio" } },
        { "type": "menu", "settings": { "heading": "Explora por productos" } },
        { "type": "menu", "settings": { "heading": "Atención a cliente" } },
        { "type": "menu", "settings": { "heading": "Nuestro Nido" } },
        { "type": "menu", "settings": { "heading": "Mayoreo" } },
        { "type": "text", "settings": { "heading": "Contacto" } }
      ]
    }
  ]
}
{% endschema %}
