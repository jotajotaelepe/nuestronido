{%- comment -%}
  Nuestro Nido image banner (Figma Home "Simplicidad y elegancia lista para llevar."):
  full-bleed photo, display headline and a taupe pill button at the bottom left.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
-%}
<section class="nn-banner" style="--nn-banner-bg: {{ s.background }};">
  <div class="nn-banner__media">
    {%- if s.image != blank -%}
      {{ s.image | image_url: width: 2880 | image_tag: loading: 'lazy', sizes: '100vw', widths: '750, 1100, 1500, 2000, 2880', alt: '' }}
    {%- elsif s.fallback_asset != blank -%}
      <img src="{{ s.fallback_asset | asset_url }}" alt="" loading="lazy">
    {%- endif -%}
  </div>
  <div class="nn-banner__content nn-wrap">
    <h2 class="nn-banner__heading nn-display">{{ s.heading }}</h2>
    {%- if s.button_label != blank -%}
      <a class="nn-banner__button" href="{{ s.button_link | default: '#' }}">{{ s.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .nn-banner { position: relative; min-height: clamp(480px, 58vw, 840px); display: flex; align-items: flex-end; overflow: hidden; background: var(--nn-banner-bg, #47423a); color: var(--nn-color-blanco); }
  .nn-banner__media { position: absolute; inset: 0; }
  .nn-banner__media img { width: 100%; height: 100%; object-fit: cover; }
  .nn-banner__content { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 40px; padding-block-end: clamp(40px, 4.5vw, 64px); }
  .nn-banner__heading { margin: 0; color: inherit; max-width: 16ch; }
  .nn-banner__heading p { margin: 0; }
  .nn-banner__button {
    display: inline-flex; align-items: center; padding: 24px 36px; border-radius: var(--nn-radius-pill);
    background: var(--nn-color-taupe); color: var(--nn-color-blanco); text-decoration: none;
    font-size: clamp(1.75rem, 1.3rem + 1.2vw, 3rem); letter-spacing: -0.05em; line-height: 1;
  }
  .nn-banner__button:hover { background: color-mix(in srgb, var(--nn-color-taupe) 85%, black); }
  @media screen and (max-width: 749px) { .nn-banner__button { padding: 16px 28px; } .nn-banner__content { gap: 24px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "NN · Banner",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "text", "id": "fallback_asset", "label": "Imagen provisional (archivo en assets)", "default": "nn-demo-banner-sofa.jpg" },
    { "type": "color", "id": "background", "label": "Fondo detrás de la imagen", "default": "#47423A" },
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Simplicidad y elegancia lista para llevar." },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Conoce más" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" }
  ],
  "presets": [{ "name": "NN · Banner" }]
}
{% endschema %}
