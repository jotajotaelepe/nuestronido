{%- doc -%}
  Nuestro Nido product card (Figma "Tarjeta producto": image, badge, title, measures,
  price + MSI chip, rating). Used by the nn-* home sections.

  @param {object} product - The product. Blank renders a provisional placeholder card.
  @param {string} [size] - 'large' (featured, big title) or 'default'.
  @param {string} [image_ratio] - CSS aspect-ratio for the image. Default '4 / 5'.
  @param {string} [fallback_image] - Asset file name used when the product has no image (provisional content).
  @param {string} [sizes] - sizes attribute for the image.
{%- enddoc -%}
{%- liquid
  assign nn_ratio = image_ratio | default: '4 / 5'
  assign nn_size = size | default: 'default'
  assign nn_sizes = sizes | default: '(min-width: 990px) 25vw, 50vw'
-%}
<article class="nn-card nn-card--{{ nn_size }}">
  <a class="nn-card__link" href="{{ product.url | default: '#' }}">
    <div class="nn-card__media" style="aspect-ratio: {{ nn_ratio }};">
      {%- if product.featured_media -%}
        {{ product.featured_media | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: nn_sizes, widths: '400, 600, 800, 1200', alt: product.featured_media.alt | default: product.title }}
      {%- elsif fallback_image != blank -%}
        <img src="{{ fallback_image | asset_url }}" alt="{{ product.title | escape }}" loading="lazy">
      {%- else -%}
        <span class="nn-card__placeholder nn-meta">Foto de producto</span>
      {%- endif -%}
    </div>
    <div class="nn-card__body">
      {%- if nn_size == 'large' -%}
        <h3 class="nn-card__title nn-card__title--large">{{ product.title | default: 'Producto' }}</h3>
        {%- render 'nn-card-meta', product: product, part: 'badge' -%}
      {%- else -%}
        {%- render 'nn-card-meta', product: product, part: 'badge' -%}
        <h3 class="nn-card__title">{{ product.title | default: 'Producto' }}</h3>
        {%- render 'nn-card-meta', product: product, part: 'subtitle' -%}
        {%- if product -%}
          {%- render 'nn-card-meta', product: product, part: 'price' -%}
          {%- render 'nn-card-meta', product: product, part: 'rating' -%}
        {%- endif -%}
      {%- endif -%}
    </div>
  </a>
</article>
