    {%- else -%}
      <path d="M18 56 H110"/>
      <path d="M26 56 V100 M102 56 V100 M38 56 L30 100 M90 56 L98 100"/>
      <path d="M18 30 H110 M18 24 V36 M110 24 V36"/>
      <path d="M8 56 V100 M4 56 H12 M4 100 H12"/>
      <path d="M48 44 H80" opacity=".6"/>
      <path d="M14 108 H120" opacity=".5"/>
  {%- endcase -%}
</svg>
