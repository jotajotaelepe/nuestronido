{%- doc -%}
  Nuestro Nido brand marks as inline SVG, exported from the Figma file.
  The wordmark letters use currentColor, the mark uses --nn-logo-mark-color (taupe by default).

  @param {string} [variant] - 'wordmark' (mark + "Nuestro Nido", default) or 'isotipo' (mark only).
  @param {string} [class] - Extra class names for the <svg>.
  @param {string} [label] - Accessible label. Defaults to the shop name.

  @example
  {% render 'nn-logo', variant: 'isotipo', class: 'nn-footer__isotipo' %}
{%- enddoc -%}

{%- liquid
  assign nn_label = label | default: shop.name | escape
-%}

